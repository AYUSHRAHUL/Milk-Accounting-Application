## Local development example (DO NOT commit real secrets)
##
## Copy this file to `.env` and fill in real values locally.
## In Git, .env may show as deleted (D) in red—that's intentional (file is untracked).
## For APK builds, set EXPO_PUBLIC_API_BASE_URL in Expo dashboard → Environment variables.

# Backend MongoDB connection string (for the Render backend only)
MONGODB_URI=

# Public base URL for the backend API (Render/Railway/etc)
# Example: https://milk-accounting-api.onrender.com
EXPO_PUBLIC_API_BASE_URL=

# Optional: enable auto server deploy during EAS Build (can also be set in `eas.json`)
# EXPO_UNSTABLE_DEPLOY_SERVER=1

